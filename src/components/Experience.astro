---
import { profile, month } from '../data/site';

type Role = (typeof profile.experience)[number];
// Consecutive roles at one company share an entry.
const groups: Role[][] = [];
for (const r of profile.experience) {
  const last = groups.at(-1);
  if (last?.[0].company === r.company) last.push(r);
  else groups.push([r]);
}
const range = (a: Role, b = a) => `${month(a.start)} — ${month(b.end)}`;
---

<section id="experience" class="wrap">
  <h2 class="reveal">Experience</h2>
  {groups.map((roles) => (
    <article class="job reveal">
      <p class="label">{range(roles.at(-1)!, roles[0])}<br />{roles.at(-1)!.location}</p>
      <div>
        <h3>{roles[0].company}</h3>
        {roles.map((r) => (
          <div class="role">
            <p class="title">{r.title}{roles.length > 1 && <span class="label"> {range(r)}</span>}</p>
            {r.highlights.length > 0 && <ul class="hl">{r.highlights.map((h) => <li>{h}</li>)}</ul>}
            {r.skills.length > 0 && <ul class="tags">{r.skills.map((s) => <li>{s}</li>)}</ul>}
          </div>
        ))}
      </div>
    </article>
  ))}
</section>

<style>
  .job { display: grid; gap: 0.75rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  h3 { font-size: 1.625rem; font-weight: 600; font-stretch: 88%; letter-spacing: -0.02em; line-height: 1.15; }
  .role { display: grid; gap: 0.9rem; margin-top: 0.35rem; }
  .role + .role { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--line); }
  .title { font-weight: 500; }
  .title .label { margin-left: 0.5em; white-space: nowrap; }
  .hl { display: grid; gap: 0.5rem; max-width: 64ch; padding-left: 1.1rem; font-size: 1rem; color: var(--muted); list-style: '–  '; }
  @media (min-width: 56rem) {
    .job { grid-template-columns: 15rem 1fr; gap: 2rem; padding-block: 2.75rem; }
    .job > .label { padding-top: 0.5rem; line-height: 1.7; }
  }
</style>
