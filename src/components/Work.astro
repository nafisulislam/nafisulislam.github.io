---
import { Image, Picture } from 'astro:assets';
import { profile, slug, art } from '../data/site';

const projects = profile.projects.map((p) => ({ ...p, ...art(p.appStoreId) }));
const featured = projects.filter((p) => p.points.length);
const rest = projects.filter((p) => !p.points.length);
// Figures inside a point (+32%, 1M, 267K) are set in the bright weight.
const metric = /(\+?\d[\d.]*[%MK])/;
const rich = (s: string) => s.split(metric);
---

<section id="work" class="wrap">
  <h2 class="reveal">Selected work</h2>
  <div class="deck" style={`timeline-scope: ${featured.slice(1).map((_, i) => `--c${i + 1}`).join(', ')}`}>
    {featured.map((p, i) => {
      const [name, tagline] = p.name.split(' — ');
      return (
        <article id={slug(p.name)} class="app" style={`view-timeline-name: --c${i}`}>
          {/* Each card dims under the next one: its animation runs on the next card's view timeline. */}
          <div class="card" style={`--c: ${p.tint ?? 'var(--accent)'}; animation-timeline: --c${i + 1}`}>
            <div class="info">
              {p.icon && <Image class="icon" src={p.icon} alt="" width={68} densities={[1, 2]} loading="lazy" />}
              <h3 class="display">{name}{tagline && <span class="soft"> — {tagline}</span>}</h3>
              <p class="label">{p.period} · {p.company}</p>
              <p class="summary">{p.summary}</p>
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              {p.url && <a class="link" href={p.url} aria-label={`View on the App Store: ${name}`}>View on the App Store <span aria-hidden="true">↗</span></a>}
            </div>
            <ul class="points">
              {p.points.map((pt) => {
                const [, n, text] = pt.match(/^(\+[\d.]+[%MK]) (.*)/) ?? [];
                return n ? (
                  <li class="stat"><b class="display">{n}</b><span>{text}</span></li>
                ) : (
                  <li>{rich(pt).map((s, i) => (i % 2 ? <b>{s}</b> : s))}</li>
                );
              })}
            </ul>
            {p.shots.length > 0 && (
              <div class="shots">
                {p.shots.map((s, i) => (
                  <Picture src={s} formats={['avif']} fallbackFormat="webp" width={280} densities={[1, 2]} alt={`${name} screenshot ${i + 1}`} loading="lazy" />
                ))}
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <h3 class="label also reveal">Also built</h3>
  <ul class="kits">
    {rest.map((p) => (
      <li id={slug(p.name)} class="reveal">
        <a href={p.url}>
          <h3 class="display">{p.name} <span aria-hidden="true">↗</span></h3>
          <p class="muted">{p.summary}</p>
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Each app is a tinted card. On tall desktop screens the cards pin and stack like a deck. */
  .app { padding-bottom: 1.5rem; }
  .card { --pad: clamp(1.25rem, 4vw, 3.5rem); display: grid; gap: 1.75rem; padding: var(--pad); border: 1px solid color-mix(in srgb, var(--c) 35%, var(--line)); border-radius: clamp(1.75rem, 4vw, 2.5rem); background: radial-gradient(120% 130% at 100% 0%, color-mix(in srgb, var(--c) 50%, var(--bg)), color-mix(in srgb, var(--c) 10%, var(--bg)) 62%); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), var(--shadow); overflow: hidden; transform-origin: top; }
  .card > * { min-width: 0; }
  .info { display: grid; gap: 0.9rem; justify-items: start; }
  .icon { width: 4.25rem; border-radius: 22.5%; box-shadow: 0 0 0 1px var(--line), var(--shadow); }
  .app h3 { font-size: clamp(2rem, 4.4vw, 3.5rem); line-height: 1; }
  .soft, .summary, .points { color: color-mix(in srgb, var(--text) 72%, transparent); }
  .summary { max-width: 46ch; }

  .points { order: 1; border-top: 1px solid var(--line); }
  .points li { padding-block: 0.65rem; border-bottom: 1px solid var(--line); }
  .stat { display: grid; grid-template-columns: 5.5rem 1fr; align-items: baseline; gap: 1rem; }
  .stat .display { font-size: 2.25rem; line-height: 1; }
  .points b { font-weight: 600; color: var(--text); }

  /* Coverflow: one screenshot in front, two angled behind. These static positions are also the reduced-motion state. */
  .shots { --h: clamp(16rem, 44svh, 21rem); display: grid; place-items: center; height: var(--h); perspective: 70rem; }
  .shots :global(picture) { grid-area: 1 / 1; }
  .shots :global(img) { height: var(--h); width: auto; border-radius: 1.4rem; box-shadow: 0 0 0 1px var(--line), 0 30px 60px -25px rgb(0 0 0 / 0.6); }
  .shots :global(picture:nth-child(1)) { z-index: 1; }
  .shots :global(picture:nth-child(2)) { transform: translateX(-58%) rotateY(30deg) scale(0.78); opacity: 0.6; }
  .shots :global(picture:nth-child(3)) { transform: translateX(58%) rotateY(-30deg) scale(0.78); opacity: 0.6; }

  @keyframes flow {
    0%, 26% { transform: none; opacity: 1; z-index: 3; }
    33.3%, 59% { transform: translateX(-58%) rotateY(30deg) scale(0.78); opacity: 0.6; z-index: 1; }
    66.6%, 93% { transform: translateX(58%) rotateY(-30deg) scale(0.78); opacity: 0.6; z-index: 1; }
    to { transform: none; opacity: 1; z-index: 3; }
  }
  @keyframes tuck { to { scale: 0.9; filter: brightness(0.45); } }

  .also { margin-top: 1rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .kits { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .kits a { display: grid; gap: 0.75rem; height: 100%; padding: 1.5rem; background: var(--glass); border: 1px solid var(--line); border-radius: 1.5rem; transition: border-color 0.2s, transform 0.4s var(--ease); }
  .kits a:hover { border-color: var(--muted); transform: translateY(-3px); }
  .kits h3 { font-size: 1.75rem; }
  .kits h3 span { display: inline-block; font-size: 0.6em; color: var(--muted); transition: transform 0.3s var(--ease); }
  .kits a:hover h3 span { transform: translate(3px, -3px); }

  @media (prefers-reduced-motion: no-preference) {
    .shots :global(picture) { animation: flow 9s var(--ease) infinite; }
    .shots :global(picture:nth-child(2)) { animation-delay: -3s; }
    .shots :global(picture:nth-child(3)) { animation-delay: -6s; }
  }
  @media (min-width: 56rem) {
    .card { --pad: clamp(2rem, 3.5vw, 3rem); grid-template: 'info shots' 'points points' / minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(2rem, 5vw, 5rem); }
    .info { grid-area: info; }
    /* Points run across the card foot so the card stays short enough to pin. */
    .points { grid-area: points; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 1.5rem; }
    .points li { padding-block: 0.9rem 0; border: 0; }
    .stat { grid-template-columns: none; gap: 0.25rem; }
    .shots { --h: clamp(18rem, 46svh, 27rem); grid-area: shots; align-self: center; }
    .kits { grid-template-columns: 1fr 1fr; }
    /* shortcut: pinning needs the whole card on screen, so short windows and phones scroll the cards normally */
    @media (min-height: 48rem) {
      .app { position: sticky; top: 4.5rem; scroll-margin-top: -0.5rem; }
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .app:not(:last-child) .card { animation: tuck linear both; animation-range: entry 10% cover 45%; }
        }
      }
    }
  }
</style>
