---
import { Image, Picture } from 'astro:assets';
import { profile, slug, art } from '../data/site';

const projects = profile.projects.map((p) => ({ ...p, ...art(p.appStoreId) }));
const featured = projects.filter((p) => p.points.length);
const rest = projects.filter((p) => !p.points.length);
// Figures inside a point (+32%, 1M, 267K) are set in the bright weight.
const metric = /(\+?\d[\d.]*[%MK])/;
const rich = (s: string) => s.split(metric);
---

<section id="work" class="wrap">
  <h2 class="reveal">Selected work</h2>
  {featured.map((p) => {
    const [name, tagline] = p.name.split(' — ');
    return (
      <article id={slug(p.name)} class:list={['app', { art: p.shots.length }]}>
        <div class="info reveal">
          {p.icon && <Image class="icon" src={p.icon} alt="" width={76} densities={[1, 2]} loading="lazy" />}
          <h3 class="display">{name}{tagline && <span class="muted"> — {tagline}</span>}</h3>
          <p class="label">{p.period} · {p.company}</p>
          <p class="summary">{p.summary}</p>
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          {p.url && <a class="link" href={p.url} aria-label={`View on the App Store: ${name}`}>View on the App Store <span aria-hidden="true">↗</span></a>}
        </div>
        <ul class="points reveal">
          {p.points.map((pt) => {
            const [, n, text] = pt.match(/^(\+[\d.]+[%MK]) (.*)/) ?? [];
            return n ? (
              <li class="stat"><b class="display">{n}</b><span>{text}</span></li>
            ) : (
              <li>{rich(pt).map((s, i) => (i % 2 ? <b>{s}</b> : s))}</li>
            );
          })}
        </ul>
        {p.shots.length > 0 && (
          <div class="shots" tabindex="0" role="group" aria-label={`${name} screenshots`}>
            {p.shots.map((s, i) => (
              <Picture src={s} formats={['avif']} fallbackFormat="webp" width={280} densities={[1, 2]} alt={`${name} on the App Store, screenshot ${i + 1}`} loading="lazy" />
            ))}
          </div>
        )}
      </article>
    );
  })}

  <h3 class="label also reveal">Also built</h3>
  <ul class="kits">
    {rest.map((p) => (
      <li id={slug(p.name)} class="reveal">
        <a href={p.url}>
          <h3 class="display">{p.name} <span aria-hidden="true">↗</span></h3>
          <p class="muted">{p.summary}</p>
          <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .app { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 6rem); border-top: 1px solid var(--line); scroll-margin-top: 3rem; }
  .app > * { min-width: 0; }
  .info { display: grid; gap: 1rem; justify-items: start; }
  .icon { width: 4.75rem; border-radius: 22.5%; box-shadow: 0 0 0 1px var(--line), var(--shadow); margin-bottom: 0.5rem; }
  .app h3 { font-size: clamp(2rem, 4.4vw, 3.25rem); line-height: 1; }
  .app:first-of-type h3 { font-size: clamp(2.75rem, 6.4vw, 4.75rem); }
  .summary { max-width: 46ch; color: var(--muted); }

  .points { border-top: 1px solid var(--line); }
  .points li { padding-block: 0.8rem; border-bottom: 1px solid var(--line); }
  .stat { display: grid; grid-template-columns: 6.25rem 1fr; align-items: baseline; gap: 1rem; color: var(--muted); }
  .stat .display { font-size: 2.75rem; line-height: 1; color: var(--accent); }
  .points b { font-weight: 600; }
  .points li:not(.stat):has(b) { color: var(--muted); }
  .points li:not(.stat) b { color: var(--text); }

  /* No App Store artwork: the points become the visual. */
  .app:not(.art) h3 { font-size: clamp(3rem, 9vw, 6.5rem); }
  .app:not(.art) .points { counter-reset: p; }
  .app:not(.art) .points li { display: grid; grid-template-columns: 2.5rem 1fr; align-items: baseline; padding-block: 1.1rem; font-size: clamp(1.375rem, 2.6vw, 2.125rem); font-weight: 600; font-stretch: 85%; letter-spacing: -0.02em; line-height: 1.1; }
  .app:not(.art) .points li::before { counter-increment: p; content: counter(p, decimal-leading-zero); font: 400 0.8125rem var(--mono); letter-spacing: 0; color: var(--accent); }

  /* Screenshots sit on rounded plates like the App Store itself; a swipeable strip on small screens. */
  .shots { display: flex; gap: 0.75rem; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .shots :global(picture) { flex: 0 0 min(58%, 15rem); scroll-snap-align: center; }
  .shots :global(img) { width: 100%; border-radius: 1.25rem; box-shadow: 0 0 0 1px var(--line), var(--shadow); }

  .also { margin-top: 1rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .kits { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .kits a { display: grid; gap: 0.75rem; height: 100%; padding: 1.5rem; background: var(--glass); border: 1px solid var(--line); border-radius: 1.5rem; transition: border-color 0.2s, transform 0.4s var(--ease); }
  .kits a:hover { border-color: var(--muted); transform: translateY(-3px); }
  .kits h3 { font-size: 1.75rem; }
  .kits h3 span { display: inline-block; font-size: 0.6em; color: var(--muted); transition: transform 0.3s var(--ease); }
  .kits a:hover h3 span { transform: translate(3px, -3px); }

  @media (min-width: 56rem) {
    .app { grid-template: 'info shots' auto 'points shots' 1fr / minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(3rem, 7vw, 7rem); }
    .app:not(.art) { grid-template: 'info points' / minmax(0, 5fr) minmax(0, 6fr); align-items: end; }
    .app.art:nth-of-type(odd) { grid-template: 'shots info' auto 'shots points' 1fr / minmax(0, 6fr) minmax(0, 5fr); }
    .info { grid-area: info; }
    .points { grid-area: points; }
    .shots { grid-area: shots; align-self: center; margin: 0; padding: 3.5rem 0; overflow: visible; }
    .shots :global(picture) { flex: 1; }
    .shots :global(picture:nth-child(1)) { --d: 1.5rem; }
    .shots :global(picture:nth-child(2)) { --d: -2rem; }
    .shots :global(picture:nth-child(3)) { --d: 3.25rem; }
    .kits { grid-template-columns: 1fr 1fr; }
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .shots :global(picture) { animation: drift linear both; animation-timeline: var(--view); }
      }
    }
  }
</style>
