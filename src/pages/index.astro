---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import Writing from '../components/Writing.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <a class="skip" href="#work">Skip to work</a>
  <div class="top">
  <nav class="nav" aria-label="Sections">
    {['Work', 'Experience', 'Writing', 'Contact'].map((s) => <a href={`#${s.toLowerCase()}`}>{s}</a>)}
  </nav>
  {/* Both icons share one cell; light-dark() hides the one for the active scheme, so it tracks the OS without JS. */}
  <button class="theme" type="button" aria-label="Toggle light or dark mode">
    <svg viewBox="0 0 24 24" style="color: light-dark(transparent, currentColor)"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2M12 20.5v2M4.6 4.6 6 6M18 18l1.4 1.4M1.5 12h2M20.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
    <svg viewBox="0 0 24 24" style="color: light-dark(currentColor, transparent)"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
  </button>
  </div>
  <Hero />
  <main>
    <Work />
    <Experience />
    <Writing />
    <Skills />
  </main>
  <Contact />
</Base>

<style>
  .top { position: fixed; top: 0.875rem; left: 50%; z-index: 5; display: flex; gap: 0.4rem; translate: -50%; }
  .nav, .theme {
    position: relative;
    display: flex;
    padding: 0.25rem;
    /* Glass: thin tint and a light blur so colors passing underneath bleed through; the inset lines are the lit rim. */
    background: color-mix(in srgb, var(--bg) 30%, transparent);
    border: 1px solid var(--line);
    border-radius: 99px;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.25), inset 0 -1px 0 rgb(255 255 255 / 0.06);
    -webkit-backdrop-filter: blur(10px) saturate(220%);
    backdrop-filter: blur(10px) saturate(220%);
    overflow: hidden;
  }
  .nav a { padding: 0.45rem 0.8rem; font-size: 0.875rem; font-weight: 500; border-radius: 99px; transition: background-color 0.2s; }
  .nav a:hover, .theme:hover { background: var(--line); }
  .theme { display: grid; place-items: center; width: 2.875rem; color: inherit; cursor: pointer; transition: background-color 0.2s; }
  .theme svg { grid-area: 1 / 1; width: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; transition: color 0.3s; }
  @media (width < 26rem) { .nav a { padding-inline: 0.45rem; } }
  .nav a:focus-visible { outline-offset: -2px; }
  /* Reading progress along the bottom edge of the pill. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .nav::after { content: ''; position: absolute; inset: auto 0 0; height: 2px; background: var(--accent); transform-origin: left; animation: grow linear both; animation-timeline: var(--page); }
    }
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelector('.theme')!.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.theme = root.dataset.theme; } catch {}
  });
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    // Hero: the dock tilts toward the pointer (--mx/--my in -1..1).
    const hero = document.querySelector<HTMLElement>('.hero')!;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', String(((e.clientX - r.left) / r.width) * 2 - 1));
      hero.style.setProperty('--my', String(((e.clientY - r.top) / r.height) * 2 - 1));
    });
  }
</script>
