---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <meta slot="head" name="robots" content="noindex" />
  <main class="wrap">
    <p class="label">404</p>
    <h1>Nothing here.</h1>
    <a class="link" href="/">Back to the portfolio <span aria-hidden="true">→</span></a>
  </main>
</Base>

<style>
  main { min-height: 100svh; display: grid; gap: 1.5rem; align-content: center; justify-items: start; }
  h1 { font-size: clamp(3rem, 12vw, 8rem); }
</style>
